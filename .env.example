PORT=3007
# Signs session cookies. Set it so logins survive a restart; without it a random one is used.
SESSION_SECRET=
# Cookies are Secure (HTTPS-only) by default. Set to 1 when running on plain http://localhost.
INSECURE_COOKIE=1
# The first boot seeds one manager account from these.
ADMIN_EMAIL=manager@example.com
ADMIN_NAME=Manager
ADMIN_PASSWORD=
# Where the SQLite file lives (default: ./data/booking.db)
DB_PATH=
# Set to 0 to start with an empty venue list instead of the fictional demo data
DEMO_SEED=1
# How often the workflow rules run, in minutes
AUTOMATION_INTERVAL_MIN=15
